# Copy to .env (which is git-ignored) and fill in the values you need.
# Never commit a filled-in .env.

# ─── AI assistant (server-side only) ──────────────────────────────────────────
# The site picks EJO_API_KEY when it is set, otherwise OPENAI_API_KEY.

# Option 1 — EJO Labs (default endpoint: https://api.ejolabs.com/api/v1/subiza)
EJO_API_KEY=
# EJO_API_URL=https://api.ejolabs.com/api/v1/subiza

# Option 2 — any OpenAI-compatible endpoint
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Admin console ────────────────────────────────────────────────────────────
ADMIN_USER=admin
# Change this. The documented default (jeanluc@2024) is in the git history, and
# the server refuses to start in production while it is still set.
ADMIN_PASSWORD=

# ─── Sessions ─────────────────────────────────────────────────────────────────
# Signs the short-lived admin/technician session tokens. Generate with:
#   openssl rand -hex 32
# Changing it signs everyone out, which is the intended way to revoke sessions.
SESSION_SECRET=

# ─── Storage ──────────────────────────────────────────────────────────────────
# The server picks a driver automatically: Turso when TURSO_DATABASE_URL is set,
# otherwise a local SQLite file (which is what development uses).
#
# Production on Netlify must use Turso: a function's filesystem is wiped between
# invocations, so a local file would silently lose every booking.
# Create a free database at https://app.turso.tech, then copy both values from
# its dashboard (the token is shown only once).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
#
# Local development only. Requires Node 22+ (built-in node:sqlite).
# JLS_DB=/absolute/path/to/jls.db

# ─── Ports ────────────────────────────────────────────────────────────────────
# PORT is what Render/Railway/Fly inject; JLS_API_PORT is the local default.
# PORT=3001
# JLS_API_PORT=3001

# ─── Front end ────────────────────────────────────────────────────────────────
# Only needed if the API ever lives on a different origin than the site.
# Leave it empty: Vite proxies /api to the local server in development, and on
# Netlify the function serves /api from the same origin.
# VITE_API_URL=https://example.com
