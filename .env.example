# Copy to .env (which is git-ignored) and fill in ONE of the two keys below.
# The site picks EJO_API_KEY when it is set, otherwise OPENAI_API_KEY.

# Option 1 — EJO Labs (default endpoint: https://api.ejolabs.com/api/v1/subiza)
EJO_API_KEY=
# EJO_API_URL=https://api.ejolabs.com/api/v1/subiza

# Option 2 — any OpenAI-compatible endpoint
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Admin console credentials (defaults shown)
# ADMIN_USER=admin
# ADMIN_PASSWORD=jeanluc@2024

# Ports
# JLS_API_PORT=3001
